{
  "manifest_version": 3,
  "name": "Fast Slot Booker v8",
  "version": "8.5.0",
  "description": "sik — new booking: refreshes the centre search with real page navigations until a centre has tests, then books a slot; change booking: looks for a slot earlier than the current test",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
